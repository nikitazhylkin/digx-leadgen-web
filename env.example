# Copy to .env.local and fill in your own values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enrichment and message generation. Can also be set on the Settings page.
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
THEIRSTACK_API_KEY=

# Optional: LinkedIn profile scrape for leads with no profile data (env only, not saved on Settings).
APIFY_TOKEN=
# Optional: Apify actor override. Default: apimaestro~linkedin-profile-detail
APIFY_LINKEDIN_ACTOR=

# Optional: Chrome extension id (read by src/lib/extension.ts, which no page uses yet), and dashboard links on Settings.
NEXT_PUBLIC_EXTENSION_ID=
NEXT_PUBLIC_SUPABASE_DASHBOARD_URL=
NEXT_PUBLIC_VERCEL_DASHBOARD_URL=
