# Copy to .env.local and fill in your own values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enrichment and message generation. Can also be set on the Settings page.
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
THEIRSTACK_API_KEY=

# Optional: Chrome extension id for the /import bridge, and dashboard links on Settings.
NEXT_PUBLIC_EXTENSION_ID=
NEXT_PUBLIC_SUPABASE_DASHBOARD_URL=
NEXT_PUBLIC_VERCEL_DASHBOARD_URL=
